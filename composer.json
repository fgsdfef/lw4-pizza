{
    "name": "your-name/pizza-store-lib",
    "description": "Pizza Store library for pizza ordering system",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.9",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "PizzaStoreLib\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PizzaStoreLib\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
