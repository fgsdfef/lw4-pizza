<?xml version="1.0"?>
<ruleset name="PizzaStoreLib">
    <description>Coding standards for PizzaStoreLib</description>
    
    <file>src</file>
    <file>tests</file>
    
    <arg name="colors"/>
    <arg value="p"/>
    
    <rule ref="PSR12"/>
    
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>
</ruleset>
